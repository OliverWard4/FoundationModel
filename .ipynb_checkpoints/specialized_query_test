    "# One-shot data settings\n",
    "SUPPORT_SEED = 0              # which single image per class is the labeled sample\n",
    "SEEDS = [0, 1, 2, 3, 4]       # support sets to average over (shows sensitivity to the chosen image)\n",
    "N_AUG_VIEWS = 32              # views per support image (view 0 is the original)\n",
    "# USE_UNLABELED_TRAIN = False   # OFF by default: check with your instructor before enabling\n",
    "\n",
    "#############################################################################\n",
    "# Data augmentation: more views of the SAME single labeled image\n",
    "# Adjust augmentation as part of your experiments.\n",
    "support_transform = transforms.Compose([\n",
    "    transforms.RandomResizedCrop(256, scale=(0.4, 1.0), ratio=(0.75, 1.333)),\n",
    "    transforms.RandomHorizontalFlip(p=0.5),\n",
    "    transforms.RandomApply([transforms.ColorJitter(0.3, 0.3, 0.2, 0.02)], p=0.8),\n",
    "    transforms.RandomApply([transforms.GaussianBlur(9, sigma=(0.1, 1.5))], p=0.3),\n",
    "    transforms.RandomGrayscale(p=0.1),\n",
    "])\n",
    "\n",
    "\n",
    "def make_views(image, n_views, seed=0):\n",
    "    \"\"\"Return [original] + (n_views - 1) random augmentations (deterministic for a given seed).\"\"\"\n",
    "    state = torch.get_rng_state()\n",
    "    torch.manual_seed(seed)\n",
    "    views = [image] + [support_transform(image) for _ in range(n_views - 1)]\n",
    "    torch.set_rng_state(state)\n",
    "    return views\n",
    "\n",
    "###############################################################################################\n",
    "# Initialize dataset configurations (PIL images, no transforms)\n",
    "train_folder = datasets.ImageFolder(TRAIN_ROOT)\n",
    "test_dataset = datasets.ImageFolder(TEST_ROOT)\n",
    "class_names = train_folder.classes\n",
    "num_classes = len(class_names)\n",
    "\n",
    "assert test_dataset.class_to_idx == train_folder.class_to_idx, (\n",
    "    \"Train and test class mappings do not match.\"\n",
    ")\n",
    "\n",
    "test_paths = [p for p, _ in test_dataset.samples]\n",
    "test_labels = torch.tensor(test_dataset.targets)\n",
    "\n",
    "###############################################################################################\n",
    "# One-shot support set: the ONLY place training labels are used.\n",
    "\n",
    "def select_support_indices(folder, seed):\n",
    "    \"\"\"Pick one random image per class.\"\"\"\n",
    "    rng = np.random.RandomState(seed)\n",
    "    targets = np.asarray(folder.targets)\n",
    "    return [int(rng.choice(np.where(targets == c)[0])) for c in range(len(folder.classes))]\n",
    "\n",
    "\n",
    "def build_support_set(folder, seed):\n",
    "    \"\"\"Return (images, labels, file paths, indices): exactly one image per class, ordered by class id.\"\"\"\n",
    "    idx = select_support_indices(folder, seed)\n",
    "    images = [folder[i][0] for i in idx]\n",
    "    labels = [folder.targets[i] for i in idx]\n",
    "    files = [folder.samples[i][0] for i in idx]\n",
    "    # Hard one-shot guard: all distinct, exactly one per class\n",
    "    assert len(idx) == len(set(idx)) == len(folder.classes), \"Support set must have one image per class.\"\n",
    "    assert labels == list(range(len(folder.classes))), \"Support set must contain each class exactly once.\"\n",
    "    return images, torch.tensor(labels), files, idx\n",
    "\n",
    "\n",
    "class OneShotSupportDataset(torch.utils.data.Dataset):\n",
    "    \"\"\"The 16 labeled images, each expanded into n_views views (class-major order).\"\"\"\n",
    "    def __init__(self, images, labels, n_views, seed):\n",
    "        self.views, self.labels = [], []\n",
    "        for k, (img, lab) in enumerate(zip(images, labels)):\n",
    "            for v in make_views(img, n_views, seed + k):\n",
    "                self.views.append(v)\n",
    "                self.labels.append(int(lab))\n",
    "\n",
    "    def __len__(self):\n",
    "        return len(self.views)\n",
    "\n",
    "    def __getitem__(self, idx):\n",
    "        return self.views[idx], self.labels[idx]\n",
    "\n",
    "\n",
    "support_images, support_labels, support_files, _ = build_support_set(train_folder, SUPPORT_SEED)\n",
    "support_dataset = OneShotSupportDataset(support_images, support_labels.tolist(), N_AUG_VIEWS, SUPPORT_SEED)\n",
    "\n",
    "# Optional unlabeled pool (paths only; labels are never read). Disabled by default.\n",
    "# unlabeled_paths = [p for p, _ in train_folder.samples] if USE_UNLABELED_TRAIN else []\n",
    "\n",
    "print(\"Classes:\", class_names)\n",
    "print(f\"Labeled support images: {len(support_images)} | Augmented support views: {len(support_dataset)} | \"\n",
    "      f\"Test: {len(test_dataset)}\")\n",
    "print(f\"Training images on disk (labels NOT used): {len(train_folder)} | \"\n",
    "      f\"Unlabeled training images used: {len(unlabeled_paths)}\")"
   ]
