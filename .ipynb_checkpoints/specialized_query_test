    "%%writefile inference.py\n",
    "\"\"\"\n",
    "One-shot scene classification inference.\n",
    "\n",
    "Examples:\n",
    "    python inference.py --image path/to/photo.jpg\n",
    "    python inference.py --data data/test            # ImageFolder layout; prints accuracy\n",
    "    python inference.py --data data/test --no-transductive\n",
    "\"\"\"\n",
    "import argparse\n",
    "\n",
    "import torch\n",
    "from torchvision import datasets\n",
    "\n",
    "from oneshot_lib import FoundationModel, encode_images_tta, transductive_refine, accuracy\n",
    "\n",
    "\n",
    "def main():\n",
    "    ap = argparse.ArgumentParser()\n",
    "    ap.add_argument(\"--artifacts\", default=\"oneshot_artifacts.pt\")\n",
    "    ap.add_argument(\"--image\", help=\"classify a single image file\")\n",
    "    ap.add_argument(\"--data\", help=\"ImageFolder-style directory; reports accuracy\")\n",
    "    ap.add_argument(\"--no-transductive\", action=\"store_true\",\n",
    "                    help=\"skip test-time refinement on the unlabeled batch\")\n",
    "    args = ap.parse_args()\n",
    "    assert args.image or args.data, \"Pass --image or --data.\"\n",
    "\n",
    "    art = torch.load(args.artifacts, map_location=\"cpu\", weights_only=True)\n",
    "    device = torch.device(\"cuda\" if torch.cuda.is_available() else \"cpu\")\n",
    "    fm = FoundationModel(art[\"backbone_kind\"], art[\"hf_name\"], device)\n",
    "    W, names = art[\"W\"], art[\"class_names\"]\n",
    "\n",
    "    def embed(paths):\n",
    "        return encode_images_tta(fm, paths) if art[\"tta\"] else fm.encode_images(paths)\n",
    "\n",
    "    if args.image:\n",
    "        feats = embed([args.image])\n",
    "        probs = torch.softmax(100.0 * feats @ W.T, dim=1)[0]\n",
    "        top = probs.topk(3)\n",
    "        for p, i in zip(top.values, top.indices):\n",
    "            print(f\"{names[i]:>14s}  {p.item() * 100:5.1f}%\")\n",
    "        return\n",
    "\n",
    "    folder = datasets.ImageFolder(args.data)\n",
    "    assert folder.classes == names, \"Class folders do not match the trained head.\"\n",
    "    paths = [p for p, _ in folder.samples]\n",
    "    labels = torch.tensor(folder.targets)\n",
    "    feats = embed(paths)\n",
    "    if art[\"transductive\"] and not args.no_transductive:\n",
    "        W = transductive_refine(feats, W, **art[\"refine_cfg\"])\n",
    "    print(f\"Accuracy on {len(paths)} images: {accuracy(feats @ W.T, labels):.2f}%\")\n",
    "\n",
