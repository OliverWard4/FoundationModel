    "M1 = \"1. Zero-shot (text prompts)\"\n",
    "M2 = \"2. One-shot prototype (raw image)\"\n",
    "M3 = \"3. + augmented support views\"\n",
    "M4 = \"4. + text/image fusion\"\n",
    "M5 = \"5. + trained head\"\n",
    "M6 = \"6. + test-time augmentation\"\n",
    "M7 = \"7. + transductive refinement\"\n",
    "ALL_METHODS = [M1, M2, M3, M4, M5, M6, M7]\n",
    "\n",
    "\n",
    "def prepare_backbone(backbone_key):\n",
    "    \"\"\"Load a frozen backbone and encode everything that does not depend on the support set.\"\"\"\n",
    "    kind, hf_name = BACKBONES[backbone_key]\n",
    "    t0 = time.time()\n",
    "    fm = FoundationModel(kind, hf_name, device)\n",
    "    text_proto = text_prototypes(fm, class_names) if fm.has_text else None\n",
    "\n",
    "    Xc = fm.encode_images(test_paths)                                        # clean test features\n",
    "    Xt = encode_images_tta(fm, test_paths) if USE_TTA else Xc                # test-time augmented\n",
    "    Xu = None # Xu = encode_images_tta(fm, unlabeled_paths) if unlabeled_paths else None\n",
    "    pool = Xt if Xu is None else torch.cat([Xt, Xu])                         # unlabeled features for stage 7\n",
    "    print(f\"[{backbone_key}] features ready in {time.time() - t0:.0f}s\")\n",
    "    return dict(fm=fm, text_proto=text_proto, Xc=Xc, Xt=Xt, pool=pool, backbone=backbone_key)\n",
    "\n",
    "\n",
    "def run_stages(seed, ctx, verbose=False):\n",
    "    \"\"\"Build the support set for `seed`, train the head, and evaluate every stage of the recipe.\"\"\"\n",
    "    fm, text_proto, Xc, Xt, pool = ctx[\"fm\"], ctx[\"text_proto\"], ctx[\"Xc\"], ctx[\"Xt\"], ctx[\"pool\"]\n",
    "\n",
    "    images, labels, files, _ = build_support_set(train_folder, seed)\n",
    "    support_ds = OneShotSupportDataset(images, labels.tolist(), N_AUG_VIEWS, seed)\n",
    "    view_feats = fm.encode_images(support_ds.views).reshape(num_classes, N_AUG_VIEWS, -1)\n",
    "\n",
    "    sup_raw = F.normalize(view_feats[:, 0], dim=-1)           # view 0 = the original image\n",
    "    sup_aug = prototypes_from_views(view_feats)\n",
    "    fused = fuse(text_proto, sup_aug, ALPHA) if text_proto is not None else sup_aug\n",
    "\n",
    "    set_random_seed(seed)\n",
    "    head = PrototypeHead(fused, scale=HEAD_CFG[\"scale\"])\n",
    "    optimizer = optim.AdamW(head.parameters(), lr=HEAD_CFG[\"lr\"], weight_decay=0.0)\n",
    "    scheduler = optim.lr_scheduler.CosineAnnealingLR(optimizer, T_max=HEAD_CFG[\"epochs\"])\n",
    "    head, history = train_head(\n",
    "        head, view_feats, optimizer, scheduler,\n",
    "        epochs=HEAD_CFG[\"epochs\"], batch_size=HEAD_CFG[\"batch_size\"],\n",
    "        label_smoothing=HEAD_CFG[\"label_smoothing\"], lam=HEAD_CFG[\"lam\"],\n",
    "        device=device, seed=seed, verbose=verbose\n",
    "    )\n",
    "    W_head = head.prototypes()\n",
    "    W_ref = transductive_refine(pool, W_head, **REFINE_CFG)\n",
    "\n",
    "    logits = {}\n",
    "    if text_proto is not None:\n",
    "        logits[M1] = Xc @ text_proto.T\n",
    "    logits[M2] = Xc @ sup_raw.T\n",
    "    logits[M3] = Xc @ sup_aug.T\n",
    "    logits[M4] = Xc @ fused.T\n",
    "    logits[M5] = Xc @ W_head.T\n",
    "    logits[M6] = Xt @ W_head.T\n",
    "    logits[M7] = Xt @ W_ref.T\n",
    "\n",
    "    accs = {m: accuracy(l, test_labels) for m, l in logits.items()}\n",
    "    return dict(accs=accs, logits=logits, history=history, files=files, W_head=W_head, W_refined=W_ref)\n",
    "\n",
    "\n",
    "def run_all_seeds(ctx, seeds=SEEDS):\n",
