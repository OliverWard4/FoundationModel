    "def train_head(\n",
    "    model,\n",
    "    view_feats,\n",
    "    optimizer,\n",
    "    scheduler=None,\n",
    "    epochs=30,\n",
    "    batch_size=128,\n",
    "    label_smoothing=0.1,\n",
    "    lam=10.0,                 # strength of the L2 anchor to the starting prototypes\n",
    "    device=\"cpu\",\n",
    "    seed=0,\n",
    "    verbose=True\n",
    "):\n",
    "    \"\"\"Train the prototype head on augmented views of the 16 support images. view_feats: [C, V, D].\"\"\"\n",
    "    C, V, D = view_feats.shape\n",
    "    X = view_feats.reshape(C * V, D).to(device)\n",
    "    y = torch.arange(C).repeat_interleave(V).to(device)\n",
    "    criterion = nn.CrossEntropyLoss(label_smoothing=label_smoothing)\n",
    "    generator = torch.Generator().manual_seed(seed)\n",
    "    model = model.to(device)\n",
    "\n",
    "    history = {\"train_loss\": [], \"train_acc\": [], \"anchor_drift\": [], \"learning_rate\": []}\n",
    "\n",
    "    for epoch in range(epochs):\n",
    "        model.train()\n",
    "        perm = torch.randperm(len(X), generator=generator).to(device)\n",
    "        total_loss, total_correct, total_seen = 0.0, 0, 0\n",
    "\n",
    "        for i in range(0, len(X), batch_size):\n",
    "            idx = perm[i:i + batch_size]\n",
    "            logits = model(X[idx])\n",
    "            anchor = ((model.W - model.W0) ** 2).sum(-1).mean()\n",
    "            loss = criterion(logits, y[idx]) + lam * anchor\n",
    "\n",
    "            optimizer.zero_grad(set_to_none=True)\n",
    "            loss.backward()\n",
    "            optimizer.step()\n",
    "\n",
    "            total_loss += loss.item() * len(idx)\n",
    "            total_correct += (logits.argmax(dim=1) == y[idx]).sum().item()\n",
    "            total_seen += len(idx)\n",
    "\n",
    "        current_lr = optimizer.param_groups[0][\"lr\"]\n",
    "        if scheduler is not None:\n",
    "            scheduler.step()\n",
    "\n",
    "        drift = (F.normalize(model.W.detach(), dim=-1) - model.W0).norm(dim=-1).mean().item()\n",
    "        history[\"train_loss\"].append(total_loss / total_seen)\n",
    "        history[\"train_acc\"].append(total_correct / total_seen)\n",
    "        history[\"anchor_drift\"].append(drift)\n",
    "        history[\"learning_rate\"].append(current_lr)\n",
    "\n",
    "        if verbose:\n",
    "            print(\n",
    "                f\"Epoch [{epoch + 1:02d}/{epochs}] | \"\n",
    "                f\"Train Loss: {history['train_loss'][-1]:.4f} | \"\n",
    "                f\"Train Acc: {history['train_acc'][-1]:.4f} | \"\n",
    "                f\"Drift: {drift:.4f} | LR: {current_lr:.6f}\"\n",
    "            )\n",
    "\n",
    "    return model, history\n",
    "\n",
    "\n",
    "@torch.inference_mode()\n",
    "def evaluate(model, feats, labels, device):\n",
    "    \"\"\"Loss and accuracy (as a fraction) of a head on precomputed features.\"\"\"\n",
    "    model.eval()\n",
    "    logits = model(feats.to(device))\n",
    "    labels = labels.to(device)\n",
    "    loss = nn.CrossEntropyLoss()(logits, labels).item()\n",
    "    acc = (logits.argmax(dim=1) == labels).float().mean().item()\n",
    "    return loss, acc\n",
    "\n",
    "\n",
    "def plot_training_history(history):\n",
    "    epochs = range(1, len(history[\"train_loss\"]) + 1)\n",
    "    fig, axes = plt.subplots(1, 3, figsize=(15, 4))\n",
    "\n",
    "    axes[0].plot(epochs, history[\"train_loss\"])\n",
    "    axes[0].set_title(\"Training loss\")\n",
    "\n",
    "    axes[1].plot(epochs, history[\"train_acc\"])\n",
    "    axes[1].set_title(\"Accuracy on augmented support views\")\n",
    "\n",
    "    axes[2].plot(epochs, history[\"anchor_drift\"])\n",
    "    axes[2].set_title(\"Drift from starting prototypes\")\n",
    "\n",
    "    for ax in axes:\n",
    "        ax.set_xlabel(\"Epoch\")\n",
    "        ax.grid(alpha=0.25)\n",
    "    plt.tight_layout()\n",
    "    plt.show()"
   ]
